{
  "manifest_version": 3,
  "name": "DocLink",
  "version": "1.6.3",
  "description": "Download IREPS Bill Status, CRN, R-NOTE, MA, PO, IC and tender documents to this PC, Recon (S3) or ECM, and fill bills in IREPS.",
  "minimum_chrome_version": "116",
  "key": "",
  "icons": {
    "16": "assets/icon16.png",
    "32": "assets/icon32.png",
    "48": "assets/icon48.png",
    "128": "assets/icon128.png"
  },
  "permissions": [
    "downloads",
    "storage",
    "unlimitedStorage",
    "tabs",
    "offscreen",
    "sidePanel",
    "identity",
    "debugger",
    "scripting",
    "alarms"
  ],
  "host_permissions": [
    "http://localhost:8765/*",
    "https://www.ireps.gov.in/*",
    "http://localhost:8000/*",
    "https://wabtec.reconalpha-staging.joulestowatts.com/*",
    "http://wctsrvecmtstsn1.wabtec.com:8080/*"
  ],
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "popup/popup.html"
  },
  "action": {
    "default_title": "DocLink - IREPS Document Automation",
    "default_icon": {
      "16": "assets/icon16.png",
      "32": "assets/icon32.png",
      "48": "assets/icon48.png",
      "128": "assets/icon128.png"
    }
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'"
  }
}
